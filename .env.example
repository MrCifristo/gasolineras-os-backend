# Base de datos
DATABASE_URL=postgresql://gasfuel_user:gasfuel_pass@localhost:5432/gasfuel_db

# Auth — firma de los access tokens (HS256).
# Generalo con: openssl rand -base64 48
# El backend no arranca si falta o si tiene menos de 32 caracteres.
# NUNCA lo expongas al navegador: si termina en una variable NEXT_PUBLIC_*,
# cualquiera puede firmar tokens y el auth entero deja de servir.
JWT_ACCESS_SECRET=

# App
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3001

# Almacenamiento de objetos (firmas). En prod: Cloudflare R2. En dev: el RustFS
# del docker-compose. El backend no arranca si faltan (falla al boot, no en la
# bomba). Para RustFS local (docker compose up -d rustfs; el bucket se crea una vez):
#   R2_ENDPOINT=http://localhost:9000
#   R2_ACCESS_KEY_ID=gasfuel_minio
#   R2_SECRET_ACCESS_KEY=gasfuel_minio_pass
#   R2_BUCKET=firmas
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Correo transaccional (Resend). El backend no arranca si faltan: un reset de
# contraseña que no manda el correo deja al usuario esperando sin saberlo.
# MAIL_FROM tiene que ser un remitente de un dominio verificado en Resend.
# El enlace de recuperación se arma con FRONTEND_URL: ${FRONTEND_URL}/reset?token=
RESEND_API_KEY=
MAIL_FROM=

# Bootstrap del primer admin sin terminal interactiva (CI, scripts).
# Si hay TTY, `pnpm bootstrap:admin` los pregunta y estas se ignoran.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOMBRE=

# Tests e2e — credenciales del admin creado con `pnpm bootstrap:admin`.
# La suite falla si no están definidas: no tiene valores por defecto.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
