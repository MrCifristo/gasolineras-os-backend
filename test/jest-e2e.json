{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^puppeteer$": "<rootDir>/__mocks__/puppeteer.js",
    "^puppeteer-core$": "<rootDir>/__mocks__/puppeteer.js"
  },
  "testTimeout": 30000,
  "verbose": true,
  "forceExit": true
}
